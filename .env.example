# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=replace_with_bot_token

# Application ID from Discord Developer Portal > General Information
CLIENT_ID=replace_with_application_id

# Optional: guild ID for immediate slash-command registration.
# If empty, commands are registered globally and can take longer to appear.
GUILD_ID=

# Defaults from the NEXUS MARKET setup
BOT_PREFIX=!
EMBED_COLOR=#BFC5D2
WELCOME_CHANNEL_ID=1556137217158815864
LOG_CHANNEL_ID=1556137216676339764
TICKET_PANEL_CHANNEL_ID=1556137219285327957
APPLICATION_CHANNEL_ID=

# Optional role/category configuration (paste actual IDs)
STAFF_ROLE_ID=
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
TICKET_CATEGORY_ID=
